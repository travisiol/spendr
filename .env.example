# Copy to .env — nothing here is required to run the site locally.

# Port for `npm run dev` (default 3040)
PORT=3040

# Token contract address shown in the two "CA" pills. Empty = "coming soon".
CONTRACT_ADDRESS=

# Wallet that receives the asset deposits on Robinhood Chain (4663).
# Payments stay disabled in /app until this AND the issuer are set.
TREASURY_ADDRESS=

# Robinhood Chain JSON-RPC (default: public mainnet endpoint)
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Virtual-card issuer. The original site's provider is not public; wire your
# own in lib/issuer.mjs (6 functions), then set these two.
ISSUER_API_URL=
ISSUER_API_KEY=
